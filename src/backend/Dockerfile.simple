# Simple Dockerfile for Azure Container Apps (no BuildKit required)
FROM mcr.microsoft.com/devcontainers/python:3.11-bullseye

# Install uv package manager
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"
ENV UV_LINK_MODE=copy
ENV UV_PYTHON_DOWNLOADS=never
ENV UV_PYTHON=/usr/local/bin/python3

WORKDIR /app

# Copy dependency files first
COPY pyproject.toml uv.lock ./

# Install dependencies using uv
RUN uv sync --frozen --no-dev
# Force virtualenv to use in-image interpreter (uv symlinks can point to host paths when cached)
RUN rm -f .venv/bin/python .venv/bin/python3 .venv/bin/python3.11 \
    && ln -s /usr/local/bin/python3 .venv/bin/python \
    && ln -s /usr/local/bin/python3 .venv/bin/python3 \
    && ln -s /usr/local/bin/python3 .venv/bin/python3.11 \
    && sed -i 's|^home = .*|home = /usr/local|' .venv/pyvenv.cfg

# Copy application code
COPY . .

# Set Python path to use uv's virtual environment
ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8000

# Default command to run the app
CMD ["uvicorn", "app_kernel:app", "--host", "0.0.0.0", "--port", "8000"]
